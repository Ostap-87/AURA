# Ссылки публикации Google Sheets (File → Share → Publish to web → CSV) для каждой вкладки.
# Пока переменная не задана, scripts/sync-data.ts берёт локальный снимок из data/source/*.csv —
# подключение реальной таблицы не требует правки кода, только эти переменные.
GOOGLE_SHEETS_CSV_FACTORIES=
GOOGLE_SHEETS_CSV_CATEGORIES=
GOOGLE_SHEETS_CSV_TOURS=
GOOGLE_SHEETS_CSV_TOUR_DAYS=
GOOGLE_SHEETS_CSV_TOUR_COSTS=
GOOGLE_SHEETS_CSV_TOUR_CONTENT=
GOOGLE_SHEETS_CSV_CONSULTING=
