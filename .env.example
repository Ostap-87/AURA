# Ссылки публикации Google Sheets (File → Share → Publish to web → CSV) для каждой вкладки.
# Пока переменная не задана, scripts/sync-data.ts берёт локальный снимок из data/source/*.csv —
# подключение реальной таблицы не требует правки кода, только эти переменные.
GOOGLE_SHEETS_CSV_FACTORIES=
GOOGLE_SHEETS_CSV_CATEGORIES=
GOOGLE_SHEETS_CSV_TOURS=
GOOGLE_SHEETS_CSV_TOUR_DAYS=
GOOGLE_SHEETS_CSV_TOUR_COSTS=
GOOGLE_SHEETS_CSV_TOUR_CONTENT=
GOOGLE_SHEETS_CSV_CONSULTING=

# --- Заявки (этап 10). Каждый канал включается своей переменной; пока пусто —
# заявка пишется только в журнал сервера и не теряется.
# Почта через Resend (https://resend.com): ключ API включает канал.
RESEND_API_KEY=
LEAD_EMAIL_TO=inquairy@aura-robotics.ru
LEAD_EMAIL_FROM=
# Telegram-бот: токен бота и id чата, куда слать заявки.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Вебхук CRM: заявка уходит POST-запросом в формате JSON.
LEAD_WEBHOOK_URL=

# --- SEO и аналитика (этап 10)
# Базовый адрес сайта для canonical, hreflang, sitemap. По умолчанию боевой домен.
NEXT_PUBLIC_SITE_URL=https://aura-robotics.ru
# Счётчики: пока идентификатор пуст, счётчик не подключается (PROJECT.md, раздел 11).
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GA_ID=
